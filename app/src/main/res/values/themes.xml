<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The UI is 100% Jetpack Compose, so the XML theme only drives the window /
        splash appearance before the Compose tree is attached. It therefore uses a
        platform parent instead of Theme.Material3.*, which lives in the
        com.google.android.material library that this Compose-only app does not
        depend on (referencing it made resource linking fail).
        The real Material 3 colour scheme is defined in ui/theme/Theme.kt.
    -->
    <style name="Theme.Khatiyan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary_emerald</item>
        <item name="android:colorPrimaryDark">@color/primary_emerald</item>
        <item name="android:colorAccent">@color/secondary_teal</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/primary_emerald</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
